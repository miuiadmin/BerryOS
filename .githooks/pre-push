#!/bin/sh
# BerryOS main 线守门 + bot 身份闸（push 层）——防线详见 .agents/notes/implemented/2026-11-16-跨根合并防线与判例.md 与 docs/规则/16-工程纪律.md
# 职责一：拒绝把跨根合并提交推进 refs/heads/main（GitHub 服务端装不了钩子，本地 push 是最后闸口）。
# 职责二（工程纪律刀阶段 6）：berryos.bot-email 登记的 bot 身份新提交只准推
# wip/auto-* 与 hermes/*（「runner 永不碰集成分支/永不自 merge」的机器面；
# 未配置则本段静默跳过）。
# lane 往 wip/* 或别的分支推不受影响；owner 逃生阀 BERRYOS_ALLOW_CROSSROOT=1。

[ "$BERRYOS_ALLOW_CROSSROOT" = "1" ] && exit 0
zero=0000000000000000000000000000000000000000
bot_email=$(git config --get berryos.bot-email 2>/dev/null)

# 全亲两两核（F92）：任一对无共同祖先 → 返 0（命中）。$@ = 全部亲 OID。
crossroot_pair() {
  while [ $# -ge 2 ]; do
    p1=$1
    shift
    for p2 in "$@"; do
      [ -z "$(git merge-base "$p1" "$p2" </dev/null 2>/dev/null)" ] && return 0
    done
  done
  return 1
}

while read -r lref lsha rref rsha; do
  # ---- bot 身份闸（工程纪律刀阶段 6；规则/16 §5）----
  # config 驱动（未配置 berryos.bot-email 则本段静默跳过——钩子保持通用）：
  # 登记的 bot 邮箱作者的本地新提交只准推 wip/auto-* 与 hermes/*——推 main
  # 或其他分支即拒（「runner 永不碰集成分支/永不自 merge」的机器面）。
  if [ -n "$bot_email" ]; then
    case "$lref" in
      refs/heads/wip/auto-*|refs/heads/hermes/*) ;;
      *)
        botrange="$rsha..$lsha"
        [ "$rsha" = "$zero" ] && botrange="$lsha"
        if git rev-list "$botrange" --author="$bot_email" 2>/dev/null | head -1 | grep -q .; then
          cat >&2 <<EOF
[berryos-guard] 拒绝：bot 身份（$bot_email）的新提交只准推 wip/auto-* 或 hermes/* 分支，
本次推送将把 bot 提交送上 $lref——runner 永不碰集成分支、永不自 merge（规则/16 §5）。
bot 正确路径：推 wip/auto-* 开 PR（label hermes-auto），人审合入。
EOF
          exit 1
        fi
        ;;
    esac
  fi
  [ "$rref" = "refs/heads/main" ] || continue
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then
    # 远端 main 新建（rsha=zero）：全史皆新落地——不设排除。--not --all 会把
    # 本地已 ref 的可达（含被推 lref 自身）整体排除 → 闸空转（2026-11-17 二次
    # 活测实抓补齐）。含 owner 授权跨根笔的线建 main 会命中拒——走逃生阀。
    range="$lsha"
  else
    range="$rsha..$lsha"
  fi
  bad=$(
    git rev-list --merges $range </dev/null 2>/dev/null | while read -r m; do
      # 多亲提取必须用 rev-list --parents——rev-parse --verify "$m^@" 对多亲提交输出为空
      pline=$(git rev-list --parents -n1 "$m" </dev/null 2>/dev/null)
      [ -n "$pline" ] || continue
      set -- $pline
      shift
      [ $# -ge 2 ] || continue
      crossroot_pair "$@" && echo "$m"
    done | head -3
  )
  if [ -n "$bad" ]; then
    cat >&2 <<'EOF'
[berryos-guard] 拒绝：本次推送将把跨根合并提交送上 refs/heads/main。

main 与 wip/sched-1.1 曾为两棵不相关历史，2026-11-16 已由 owner 跨根收口合并（两线
自此共史）；此后新的无共同祖先合并即异常动作，不经 local main 直推。
lane 正确路径：工作推 wip/sched-1.1；跨线内容走净增量重放。
owner 确要跨线收口：BERRYOS_ALLOW_CROSSROOT=1 git push
判例：.agents/notes/implemented/2026-11-16-跨根合并防线与判例.md
EOF
    exit 1
  fi
done
exit 0
