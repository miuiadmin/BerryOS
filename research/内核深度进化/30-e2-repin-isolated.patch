diff --git a/kernel/src/ktest.rs b/kernel/src/ktest.rs
index 974b3f8f2..caf224f23 100644
--- a/kernel/src/ktest.rs
+++ b/kernel/src/ktest.rs
@@ -3309,6 +3309,100 @@ fn test_vmo() {
     let v = unsafe { core::ptr::read_volatile(0x20_0000 as *const u64) };
     assert_eq!(v, MAGIC, "VMO：子映射经共享表根可读（同 PA 双 VA 别名）");
 
+    // E2. 跨 2MiB 段边界映射（回流重钉——12 号件施工案，区间树批量形口径）：
+    // 三页区间 [0x3F_F000, 0x40_2000) 骑跨 0x40_0000 边界——页 0 落段 1 尾槽
+    // 511、页 1/2 落段 2 首槽 0/1。新形态下跨段行为等价由每页独立
+    // l3_slot_create/peek 构造性覆盖（Q110 游标消亡，05 号义务 4 原判）；
+    // 本例断言面与 base 线 E2 逐字同文（VA 常量/魔数/期望故障臂），
+    // 另带三笔增量钉板（A 半提交零残留 / B unmap 后重 map 零树残留 /
+    // C protect 子区间切分）——区间树新增语义面，base 形无此面。
+    let mut vmo3 = Vmo::create(PAGE_SIZE * 3).expect("VMO：跨段 VMO create");
+    vmo3.commit(fa, 0, PAGE_SIZE * 3).expect("VMO：跨段 commit");
+    const M2_0: u64 = 0x0BAD_0000_C0DE_0001;
+    const M2_1: u64 = 0x0BAD_0000_C0DE_0002;
+    const M2_2: u64 = 0x0BAD_0000_C0DE_0003;
+    vmo3.write(0, &M2_0.to_le_bytes()).expect("VMO：跨段写页 0");
+    vmo3.write(PAGE_SIZE, &M2_1.to_le_bytes()).expect("VMO：跨段写页 1");
+    vmo3.write(2 * PAGE_SIZE, &M2_2.to_le_bytes()).expect("VMO：跨段写页 2");
+    root.map(fa, &mut vmo3, 0x3F_F000, 0, PAGE_SIZE * 3, Perm::Rw)
+        .expect("VMO：跨段 map（每页独立三极走查）");
+    // SAFETY: 读已映射页（root 激活态）。
+    assert_eq!(
+        unsafe { core::ptr::read_volatile(0x3F_F000 as *const u64) },
+        M2_0,
+        "VMO：跨段读段 1 尾槽 511"
+    );
+    assert_eq!(
+        unsafe { core::ptr::read_volatile(0x40_0000 as *const u64) },
+        M2_1,
+        "VMO：跨段读段 2 首槽 0"
+    );
+    assert_eq!(
+        unsafe { core::ptr::read_volatile(0x40_1000 as *const u64) },
+        M2_2,
+        "VMO：跨段读段 2 槽 1"
+    );
+    // protect 跨段降权（Ro）→ 写必 fault；提回 Rw → 写通。
+    root.protect(0x3F_F000, PAGE_SIZE * 3, Perm::Ro)
+        .expect("VMO：跨段 protect→RO");
+    for va in [0x3F_F000usize, 0x40_0000, 0x40_1000] {
+        hal::trap::arm_expected_fault(va);
+        // SAFETY: 预期 Permission fault（期望故障槽已 arm）。
+        unsafe { core::ptr::write_volatile(va as *mut u64, 0) };
+        assert!(!hal::trap::fault_armed(), "VMO：跨段 RO 页写居然没 fault");
+    }
+    root.protect(0x3F_F000, PAGE_SIZE * 3, Perm::Rw)
+        .expect("VMO：跨段 protect→RW");
+    // SAFETY: 写已提权页。
+    unsafe { core::ptr::write_volatile(0x40_0000 as *mut u64, MAGIC2) };
+    vmo3.read(PAGE_SIZE, &mut buf).expect("VMO：跨段 read back");
+    assert_eq!(u64::from_le_bytes(buf), MAGIC2, "VMO：跨段 VA 写→VMO 读一致");
+
+    // 增量钉板 C（protect 子区间切分——overhaul 新增语义）：三页整区间
+    // Rw 态下仅中页 [0x40_0000, 0x40_1000) 降 Ro——中页写必 fault、首尾
+    // 两页写仍通（vmarface 切分路径残余前缀/后缀保留原 perm）。
+    root.protect(0x40_0000, PAGE_SIZE, Perm::Ro)
+        .expect("VMO：切分 protect 仅中页→RO");
+    hal::trap::arm_expected_fault(0x40_0000);
+    // SAFETY: 预期 Permission fault（期望故障槽已 arm）。
+    unsafe { core::ptr::write_volatile(0x40_0000 as *mut u64, 0) };
+    assert!(!hal::trap::fault_armed(), "VMO：切分后中页 RO 写居然没 fault");
+    // SAFETY: 写切分残余页（首尾仍 Rw）。
+    unsafe { core::ptr::write_volatile(0x3F_F000 as *mut u64, M2_0) };
+    unsafe { core::ptr::write_volatile(0x40_1000 as *mut u64, M2_2) };
+    root.protect(0x3F_F000, PAGE_SIZE * 3, Perm::Rw)
+        .expect("VMO：切分复原整区间→RW");
+
+    // unmap 跨段清叶 → 读必 fault（三页跨两段全清）。
+    root.unmap(0x3F_F000, PAGE_SIZE * 3).expect("VMO：跨段 unmap");
+
+    // 增量钉板 B（unmap 后重 map 零树残留）：同区间重 map 必 Ok——
+    // unmap_range 若 active_leaves 未净除则重 map 必 Overlap 拒；重 map
+    // 成功即零残留反向钉板。重 map 后再 unmap 收净，转增量钉板 A。
+    root.map(fa, &mut vmo3, 0x3F_F000, 0, PAGE_SIZE * 3, Perm::Rw)
+        .expect("VMO：unmap 后重 map（零树残留反向钉板）");
+    root.unmap(0x3F_F000, PAGE_SIZE * 3)
+        .expect("VMO：重 map 后再 unmap 收净");
+
+    // 增量钉板 A（半提交零提交——map 预检面）：三页 VMO 只 commit 页 0，
+    // 整区间 map 必 Err(VmoNotCommitted)（先全量预检后填叶两阶段不变量：
+    // 拒收时零 L3 写入零树插入）；随补 commit 页 1/2 后同区间重 map 必成。
+    let mut vmo4 = Vmo::create(PAGE_SIZE * 3).expect("VMO：半提交 VMO create");
+    vmo4.commit(fa, 0, PAGE_SIZE).expect("VMO：只 commit 页 0");
+    assert_eq!(
+        root.map(fa, &mut vmo4, 0x3F_F000, 0, PAGE_SIZE * 3, Perm::Rw),
+        Err(VmarError::VmoNotCommitted),
+        "VMO：半提交整区间 map 预检面必须拒"
+    );
+    vmo4.commit(fa, PAGE_SIZE, PAGE_SIZE * 2)
+        .expect("VMO：补 commit 页 1/2");
+    root.map(fa, &mut vmo4, 0x3F_F000, 0, PAGE_SIZE * 3, Perm::Rw)
+        .expect("VMO：补齐后重 map 必成（预检面构造性）");
+    root.unmap(0x3F_F000, PAGE_SIZE * 3)
+        .expect("VMO：钉板 A 后 unmap 收净");
+    drop(vmo4);
+    drop(vmo3);
+
     // F. A1-2 容量冒烟：40MiB VMO 全量 commit/decommit——`vmo.rs` commit 逐页
     // order-0 出帧，不受 MAX_ORDER 堆单块地形约束；帧账本对账（B-0
     // `allocated_pages` 口径）钉「10240 页全出全还、零泄漏」。40MB+ blob
